# PPTist Server 环境变量示例 —— 全部为占位符，禁止填真实密钥后入库
# 用法：复制为 .env 或按部署方式注入环境变量

DATA_DIR=./data
PORT=3100
HOST=0.0.0.0
# 生产填 https://域名；决定管理台 Cookie 是否自动加 Secure
PUBLIC_BASE_URL=http://localhost:5173
RENDER_BASE_URL=http://127.0.0.1:3100
STATIC_DIR=./dist

# 管理台：首次启动初始化密码（≥10 字符；仅库里无密码时生效）。
# 这里只能放占位符，真实值通过部署渠道注入。
ADMIN_INITIAL_PASSWORD=<set-a-strong-admin-password>
ADMIN_SESSION_TTL_HOURS=12
ADMIN_LOGIN_RATE_PER_MIN=5
# ADMIN_SECURE_COOKIES=1   # 仅当确认全程 HTTPS 时强制开启
# TRUST_PROXY=1            # 仅在可信反代之后开启
