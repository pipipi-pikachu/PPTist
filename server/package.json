{
  "name": "pptist-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pptist-admin": "dist/admin.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/admin.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "fast-json-patch": "^3.1.1",
    "fastify": "^5.12.8",
    "nanoid": "^6.0.2",
    "playwright": "~1.56.0",
    "sanitize-html": "^2.18.1",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/yazl": "^2.4.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
